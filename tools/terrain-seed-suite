#!/usr/bin/env bash
set -euo pipefail

if [[ $# -ne 1 ]]; then
  echo "usage: tools/terrain-seed-suite OUTPUT_DIR" >&2
  exit 2
fi

root=$(cd "$(dirname "$0")/.." && pwd)
output=$1
seeds=${MOPPE_TERRAIN_SEEDS:-"123 126 133 1785400205"}
resolution=${MOPPE_TERRAIN_RESOLUTION:-}
graphics=${MOPPE_GAZETTEER_GRAPHICS:-high}
window=${MOPPE_GAZETTEER_WINDOW:-1600x900}
settle=${MOPPE_GAZETTEER_SETTLE:-18}
uplift_years=${MOPPE_UPLIFT_YEARS:-500000}
channel_area=${MOPPE_CHANNEL_INITIATION_AREA:-100}
critical_gradient=${MOPPE_HILLSLOPE_CRITICAL_GRADIENT:-0.6}
maximum_multiplier=${MOPPE_HILLSLOPE_MAX_MULTIPLIER:-4}

resolution_arguments=()
if [[ -n $resolution ]]; then
  resolution_arguments+=(--terrain-resolution "$resolution")
fi

mkdir -p "$output"
for seed in $seeds; do
  if [[ ! $seed =~ ^[0-9]+$ ]]; then
    echo "MOPPE_TERRAIN_SEEDS must contain non-negative integers" >&2
    exit 2
  fi
  variant="$output/seed-$seed"
  cache_key="terrain-acceptance-$seed"
  if [[ -f $variant/terrain-summary.csv &&
        -f $variant/terrain-spectrum.csv &&
        -f $variant/gazetteer.csv &&
        -f $variant/capture.txt &&
        -f $variant/cache-check/stderr.log ]] &&
     grep -q "world cache: local=" "$variant/cache-check/stderr.log"; then
    echo "reusing completed seed $seed"
    continue
  fi
  if [[ -f $variant/failure.txt ]]; then
    echo "reusing failed seed $seed"
    continue
  fi
  mkdir -p "$variant"
  set +e
  MOPPE_SEED="$seed" \
  MOPPE_TERRAIN_PROFILE=play \
  MOPPE_TERRAIN_RESOLUTION="$resolution" \
  MOPPE_GAZETTEER_GRAPHICS="$graphics" \
  MOPPE_GAZETTEER_WINDOW="$window" \
  MOPPE_GAZETTEER_SETTLE="$settle" \
  MOPPE_UPLIFT_YEARS="$uplift_years" \
  MOPPE_CHANNEL_INITIATION_AREA="$channel_area" \
  MOPPE_HILLSLOPE_CRITICAL_GRADIENT="$critical_gradient" \
  MOPPE_HILLSLOPE_MAX_MULTIPLIER="$maximum_multiplier" \
  MOPPE_WORLD_CACHE_KEY="$cache_key" \
  MOPPE_REFRESH_WORLD_CACHE=1 \
  MOPPE_MAPCACHE="$variant/terrain-cache.arrows" \
    "$root/tools/capture-terrain-gazetteer" "$variant"
  capture_status=$?
  set -e
  if [[ $capture_status -ne 0 ]]; then
    printf 'capture_exit_status=%s\n' "$capture_status" \
      >"$variant/failure.txt"
    echo "seed $seed failed with status $capture_status" >&2
    continue
  fi

  "$root/tools/terrain-spectrum" "$variant"

  mkdir -p "$variant/cache-check"
  MOPPE_METAL_HUD=0 \
  MOPPE_CINEMATIC_CAPTURE_DIR="$variant/cache-check" \
  MOPPE_CINEMATIC_CAPTURE_FRAMES=1 \
  "$root/build/moppe.app/Contents/MacOS/moppe" \
    --windowed \
    --inactive \
    --seed "$seed" \
    --terrain-quality play \
    "${resolution_arguments[@]}" \
    --uplift-years "$uplift_years" \
    --channel-initiation-area "$channel_area" \
    --hillslope-critical-gradient "$critical_gradient" \
    --hillslope-max-multiplier "$maximum_multiplier" \
    --graphics-quality "$graphics" \
    --world-cache-key "$cache_key" \
    >"$variant/cache-check/stdout.log" \
    2>"$variant/cache-check/stderr.log"
  if ! grep -q "world cache: local=" "$variant/cache-check/stderr.log"; then
    echo "seed $seed did not load its finished-world cache" >&2
    exit 1
  fi
done

python3 - "$output" <<'PY'
import csv
import pathlib
import sys

root = pathlib.Path(sys.argv[1])
rows = []
fieldnames = None
core_views = {"headwater", "river-reach", "confluence", "river-mouth"}
for path in sorted(
    root.glob("seed-*/terrain-summary.csv"),
    key=lambda item: int(item.parent.name.removeprefix("seed-")),
):
    with path.open(newline="") as source:
        summary_reader = csv.DictReader(source)
        row = next(summary_reader)
    with (path.parent / "terrain-spectrum.csv").open(newline="") as source:
        spectrum_reader = csv.DictReader(source)
        row.update(next(spectrum_reader))
    with (path.parent / "gazetteer.csv").open(newline="") as source:
        gazetteer = list(csv.DictReader(source))
    names = {view["name"] for view in gazetteer}
    capture = {}
    with (path.parent / "capture.txt").open() as source:
        for line in source:
            key, value = line.rstrip().split("=", 1)
            capture[key] = value
    row["gazetteer_views"] = len(gazetteer)
    row["core_water_views"] = len(names & core_views)
    row["process_elapsed_seconds"] = capture["process_elapsed_seconds"]
    fieldnames = [
        *summary_reader.fieldnames,
        *spectrum_reader.fieldnames,
        "gazetteer_views",
        "core_water_views",
        "process_elapsed_seconds",
    ]
    rows.append(row)

if rows:
    with (root / "suite.csv").open("w", newline="") as destination:
        writer = csv.DictWriter(destination, fieldnames=fieldnames)
        writer.writeheader()
        writer.writerows(rows)

with (root / "failures.csv").open("w", newline="") as destination:
    writer = csv.writer(destination)
    writer.writerow(["seed", "failure"])
    for path in sorted(
        root.glob("seed-*/failure.txt"),
        key=lambda item: int(item.parent.name.removeprefix("seed-")),
    ):
        writer.writerow([
            path.parent.name.removeprefix("seed-"),
            path.read_text().strip(),
        ])
PY

echo "wrote terrain seed suite to $output/suite.csv"

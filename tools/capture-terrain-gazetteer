#!/usr/bin/env bash
set -euo pipefail

if [[ $# -ne 1 ]]; then
  echo "usage: tools/capture-terrain-gazetteer OUTPUT_DIR" >&2
  exit 2
fi

root=$(cd "$(dirname "$0")/.." && pwd)
build_dir=${MOPPE_BUILD_DIR:-"$root/build"}
output=$1
seed=${MOPPE_SEED:-123}
# The play profile is what the game itself generates; finished worlds cache,
# so only the first capture of a recipe pays for the full evolution.
terrain=${MOPPE_TERRAIN_PROFILE:-play}
terrain_resolution=${MOPPE_TERRAIN_RESOLUTION:-}
graphics=${MOPPE_GAZETTEER_GRAPHICS:-high}
settle=${MOPPE_GAZETTEER_SETTLE:-18}
window=${MOPPE_GAZETTEER_WINDOW:-1600x900}
uplift_years=${MOPPE_UPLIFT_YEARS:-}
channel_area=${MOPPE_CHANNEL_INITIATION_AREA:-}
sediment_concentration=${MOPPE_SEDIMENT_CONCENTRATION:-}
critical_hillslope_gradient=${MOPPE_HILLSLOPE_CRITICAL_GRADIENT:-}
maximum_hillslope_multiplier=${MOPPE_HILLSLOPE_MAX_MULTIPLIER:-}
cache_key=${MOPPE_WORLD_CACHE_KEY:-}
refresh_cache=${MOPPE_REFRESH_WORLD_CACHE:-0}

if [[ ! $settle =~ ^[1-9][0-9]*$ ]]; then
  echo "MOPPE_GAZETTEER_SETTLE must be a positive integer" >&2
  exit 2
fi
if [[ -n $terrain_resolution &&
      ! $terrain_resolution =~ ^[1-9][0-9]*$ ]]; then
  echo "MOPPE_TERRAIN_RESOLUTION must be a positive integer" >&2
  exit 2
fi
if [[ -n $uplift_years && ! $uplift_years =~ ^[0-9]+$ ]]; then
  echo "MOPPE_UPLIFT_YEARS must be a non-negative integer" >&2
  exit 2
fi
if [[ -n $channel_area && ! $channel_area =~ ^[1-9][0-9]*$ ]]; then
  echo "MOPPE_CHANNEL_INITIATION_AREA must be a positive integer" >&2
  exit 2
fi
if [[ -n $sediment_concentration &&
      ! $sediment_concentration =~ ^(0|[0-9]+)(\.[0-9]+)?$ ]]; then
  echo "MOPPE_SEDIMENT_CONCENTRATION must be a non-negative decimal" >&2
  exit 2
fi
if [[ -n $critical_hillslope_gradient &&
      ! $critical_hillslope_gradient =~ ^(0|[0-9]+)(\.[0-9]+)?$ ]]; then
  echo "MOPPE_HILLSLOPE_CRITICAL_GRADIENT must be a decimal" >&2
  exit 2
fi
if [[ -n $maximum_hillslope_multiplier &&
      ! $maximum_hillslope_multiplier =~ ^(0|[0-9]+)(\.[0-9]+)?$ ]]; then
  echo "MOPPE_HILLSLOPE_MAX_MULTIPLIER must be a decimal" >&2
  exit 2
fi
if [[ -e $output ]] && compgen -G "$output/frame-*.png" >/dev/null; then
  echo "$output already contains captured frames" >&2
  exit 1
fi
if [[ ! -f $build_dir/build.ninja ]]; then
  cmake -S "$root" -B "$build_dir" -G Ninja \
    -DCMAKE_BUILD_TYPE=RelWithDebInfo
fi

cmake --build "$build_dir" --target moppe_bundle_shaders
mkdir -p "$output"

arguments=(
  --terrain-gazetteer "$output"
  --gazetteer-settle "$settle"
  --windowed
  --window-size "$window"
  --inactive
  --seed "$seed"
  --terrain-quality "$terrain"
  --graphics-quality "$graphics"
)
if [[ -n $uplift_years ]]; then
  arguments+=(--uplift-years "$uplift_years")
fi
if [[ -n $terrain_resolution ]]; then
  arguments+=(--terrain-resolution "$terrain_resolution")
fi
if [[ -n $channel_area ]]; then
  arguments+=(--channel-initiation-area "$channel_area")
fi
if [[ -n $sediment_concentration ]]; then
  arguments+=(--sediment-concentration "$sediment_concentration")
fi
if [[ -n $critical_hillslope_gradient ]]; then
  arguments+=(--hillslope-critical-gradient "$critical_hillslope_gradient")
fi
if [[ -n $maximum_hillslope_multiplier ]]; then
  arguments+=(--hillslope-max-multiplier "$maximum_hillslope_multiplier")
fi
if [[ -n $cache_key ]]; then
  arguments+=(--world-cache-key "$cache_key")
fi
if [[ $refresh_cache == 1 ]]; then
  arguments+=(--refresh-world-cache)
fi

start_seconds=$SECONDS
MOPPE_METAL_HUD=0 \
  "$build_dir/moppe.app/Contents/MacOS/moppe" \
    "${arguments[@]}"
elapsed_seconds=$((SECONDS - start_seconds))

printf '%s\n' \
  "mode=frozen-frame-composition" \
  "seed=$seed" \
  "terrain=$terrain" \
  "terrain_resolution=${terrain_resolution:-profile-default}" \
  "graphics=$graphics" \
  "window=$window" \
  "settle_frames=$settle" \
  "uplift_years=${uplift_years:-profile-default}" \
  "channel_initiation_area_m2=${channel_area:-profile-default}" \
  "sediment_concentration=${sediment_concentration:-profile-default}" \
  "critical_hillslope_gradient=${critical_hillslope_gradient:-profile-default}" \
  "maximum_hillslope_multiplier=${maximum_hillslope_multiplier:-profile-default}" \
  "world_cache_key=${cache_key:-default}" \
  "refresh_world_cache=$refresh_cache" \
  "process_elapsed_seconds=$elapsed_seconds" \
  >"$output/capture.txt"

"$root/tools/gazetteer-report" "$output"
echo "wrote the landscape gazetteer to $output"

#!/usr/bin/env bash
set -euo pipefail

if [[ $# -ne 1 ]]; then
  echo "usage: tools/capture-terrain-gazetteer OUTPUT_DIR" >&2
  exit 2
fi

root=$(cd "$(dirname "$0")/.." && pwd)
build_dir=${MOPPE_BUILD_DIR:-"$root/build"}
output=$1
seed=${MOPPE_SEED:-123}
# The play profile is what the game itself generates; finished worlds cache,
# so only the first capture of a recipe pays for the full evolution.
terrain=${MOPPE_TERRAIN_PROFILE:-play}
graphics=${MOPPE_GAZETTEER_GRAPHICS:-high}
settle=${MOPPE_GAZETTEER_SETTLE:-18}
window=${MOPPE_GAZETTEER_WINDOW:-1600x900}
uplift_years=${MOPPE_UPLIFT_YEARS:-}
cache_key=${MOPPE_WORLD_CACHE_KEY:-}
refresh_cache=${MOPPE_REFRESH_WORLD_CACHE:-0}

if [[ ! $settle =~ ^[1-9][0-9]*$ ]]; then
  echo "MOPPE_GAZETTEER_SETTLE must be a positive integer" >&2
  exit 2
fi
if [[ -n $uplift_years && ! $uplift_years =~ ^[0-9]+$ ]]; then
  echo "MOPPE_UPLIFT_YEARS must be a non-negative integer" >&2
  exit 2
fi
if [[ -e $output ]] && compgen -G "$output/frame-*.png" >/dev/null; then
  echo "$output already contains captured frames" >&2
  exit 1
fi
if [[ ! -f $build_dir/build.ninja ]]; then
  cmake -S "$root" -B "$build_dir" -G Ninja \
    -DCMAKE_BUILD_TYPE=RelWithDebInfo
fi

cmake --build "$build_dir" --target moppe_bundle_shaders
mkdir -p "$output"

arguments=(
  --terrain-gazetteer "$output"
  --gazetteer-settle "$settle"
  --windowed
  --window-size "$window"
  --inactive
  --seed "$seed"
  --terrain-quality "$terrain"
  --graphics-quality "$graphics"
)
if [[ -n $uplift_years ]]; then
  arguments+=(--uplift-years "$uplift_years")
fi
if [[ -n $cache_key ]]; then
  arguments+=(--world-cache-key "$cache_key")
fi
if [[ $refresh_cache == 1 ]]; then
  arguments+=(--refresh-world-cache)
fi

start_seconds=$SECONDS
MOPPE_METAL_HUD=0 \
  "$build_dir/moppe.app/Contents/MacOS/moppe" \
    "${arguments[@]}"
elapsed_seconds=$((SECONDS - start_seconds))

printf '%s\n' \
  "mode=frozen-frame-composition" \
  "seed=$seed" \
  "terrain=$terrain" \
  "graphics=$graphics" \
  "window=$window" \
  "settle_frames=$settle" \
  "uplift_years=${uplift_years:-profile-default}" \
  "world_cache_key=${cache_key:-default}" \
  "refresh_world_cache=$refresh_cache" \
  "process_elapsed_seconds=$elapsed_seconds" \
  >"$output/capture.txt"

"$root/tools/gazetteer-report" "$output"
echo "wrote the landscape gazetteer to $output"

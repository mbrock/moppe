#!/usr/bin/env python3
"""Replay a raw Metal frame in Xcode, or read an existing Xcode export."""

import argparse
import json
from pathlib import Path
import subprocess
import sys


def shader_rows(trace):
    # go prints a truncated first page. list --all emits the complete table.
    result = subprocess.run(
        ["gpudebug", "--oneshot", "--json", "-t", str(trace),
         "-c", "profile load", "-c", "go performance/shaders",
         "-c", "list --all"],
        capture_output=True, text=True, check=True,
    )
    table = None
    for line in result.stdout.splitlines():
        # gpudebug 1.0 mixes plain-text diagnostics with JSON records.
        if line.startswith("error:"):
            raise ValueError(line)
        if line.startswith("{"):
            record = json.loads(line)
            if record.get("success") is False:
                raise ValueError(record.get("notification", str(record))
                                 + ". Check Embed performance data on export.")
            if "children" in record:
                table = record

    if not table or len(table["children"]) != table["totalCount"]:
        raise ValueError("gpudebug did not return a complete shader table")
    rows = []
    for row in table["children"]:
        function, pipeline, cost, uses = row["values"]
        if cost["type"] != "percentage":
            raise ValueError("unrecognized gpudebug shader table")
        rows.append(dict(id=row["name"], function=function["value"],
                         pipeline=pipeline["value"], cost_percent=cost["value"],
                         draw_or_dispatch_uses=int(uses["value"])))
    if not any(row["cost_percent"] > 0 for row in rows):
        raise ValueError("no positive shader costs. Replay with profiling "
                         "in Xcode and export with Embed performance data.")
    return sorted(rows, key=lambda row: -row["cost_percent"])


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("trace", type=Path, help="input .gputrace bundle")
    parser.add_argument("export", type=Path, nargs="?",
                        help="new .gputrace to create through Xcode. Omit "
                             "to read embedded data from the input.")
    args = parser.parse_args()
    trace = args.trace.resolve()
    if trace.suffix != ".gputrace" or not trace.is_dir():
        parser.error("input must be an existing .gputrace directory")
    if args.export:
        output = args.export.absolute()
        if (output.suffix != ".gputrace" or output.exists()
                or output.is_symlink() or not output.parent.is_dir()
                or trace in output.resolve().parents):
            parser.error("choose a new .gputrace path outside the input "
                         "bundle, in an existing directory")
        helper = Path(__file__).resolve().with_name("metal-profile-export.swift")
        subprocess.run(["xcrun", "swift", str(helper), str(trace),
                        str(output)], check=True)
        trace = output
    print(json.dumps(shader_rows(trace), indent=2))


if __name__ == "__main__":
    try:
        main()
    except subprocess.CalledProcessError as error:
        sys.exit(error.stderr or f"{error.cmd[0]} exited {error.returncode}")
    except (OSError, ValueError, KeyError) as error:
        sys.exit(str(error))

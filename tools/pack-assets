#!/usr/bin/env python3
"""Packs the game's assets for building into its executable.

    tools/pack-assets OUTPUT_DIR PATH=NAME...

Each file PATH, which the game asks for as the asset NAME, is compressed
with zstd into OUTPUT_DIR, and OUTPUT_DIR/embedded_assets.inc lists them for the SDL host's services
(moppe/platform/sdl/services.cc), which #embed them. A land file's 16-bit
columns (*.arrows) are delta coded and split into low and high bytes first,
which takes the default land from 28 MB to 21. Needs zstd on PATH (or
MOPPE_ZSTD).
"""

import array
import hashlib
import os
import subprocess
import sys


def delta16(data):
    """Little-endian 16-bit words as the differences of neighbours, low
    bytes then high bytes, with an odd last byte as it was."""
    words = array.array("H")
    words.frombytes(data[: len(data) // 2 * 2])
    if sys.byteorder != "little":
        words.byteswap()
    previous = 0
    for i, word in enumerate(words):
        words[i] = (word - previous) & 0xFFFF
        previous = word
    if sys.byteorder != "little":
        words.byteswap()
    pairs = words.tobytes()
    return pairs[0::2] + pairs[1::2] + data[len(pairs) :]


def main():
    output, assets = sys.argv[1], sys.argv[2:]
    zstd = os.environ.get("MOPPE_ZSTD", "zstd")
    os.makedirs(output, exist_ok=True)
    identity = hashlib.sha256()
    arrays, entries = [], []
    pairs = [asset.rsplit("=", 1) for asset in assets]
    for index, (path, relative) in enumerate(
        sorted(pairs, key=lambda pair: pair[1])
    ):
        with open(path, "rb") as file:
            data = file.read()
        identity.update(relative.encode() + b"\0" + data)
        delta = relative.endswith(".arrows")
        packed = os.path.join(output, f"asset-{index}.zst")
        subprocess.run(
            [zstd, "-19", "-q", "-f", "-o", packed],
            input=delta16(data) if delta else data,
            check=True,
        )
        arrays.append(
            f"alignas (8) const unsigned char asset_{index}[] = {{\n"
            f'#embed "{os.path.abspath(packed).replace(os.sep, "/")}"\n}};\n'
        )
        entries.append(
            f'  {{"{relative}", asset_{index}, sizeof asset_{index}, '
            f"{len(data)}u, {'true' if delta else 'false'}}},\n"
        )
    text = (
        "// Generated by tools/pack-assets; the assets built into the game.\n"
        f'#define MOPPE_EMBEDDED_ASSETS_ID "{identity.hexdigest()[:16]}"\n'
        + "".join(arrays)
        + "const EmbeddedAsset embedded_assets[] = {\n"
        + "".join(entries)
        + "};\n"
    )
    with open(os.path.join(output, "embedded_assets.inc"), "w") as file:
        file.write(text)


if __name__ == "__main__":
    main()

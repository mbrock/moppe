#!/usr/bin/env bash
set -euo pipefail

if [[ $# -ne 1 ]]; then
  echo "usage: tools/terrain-forcing-matrix OUTPUT_DIR" >&2
  exit 2
fi

root=$(cd "$(dirname "$0")/.." && pwd)
output=$1
seed=${MOPPE_SEED:-123}
graphics=${MOPPE_GAZETTEER_GRAPHICS:-high}
window=${MOPPE_GAZETTEER_WINDOW:-1600x900}
settle=${MOPPE_GAZETTEER_SETTLE:-18}

if [[ -e $output ]]; then
  echo "$output already exists" >&2
  exit 1
fi

mkdir -p "$output"

for uplift_years in 250000 500000 750000; do
  variant="$output/uplift-$uplift_years"
  cache_key="forcing-$uplift_years"
  MOPPE_SEED="$seed" \
  MOPPE_TERRAIN_PROFILE=play \
  MOPPE_GAZETTEER_GRAPHICS="$graphics" \
  MOPPE_GAZETTEER_WINDOW="$window" \
  MOPPE_GAZETTEER_SETTLE="$settle" \
  MOPPE_UPLIFT_YEARS="$uplift_years" \
  MOPPE_WORLD_CACHE_KEY="$cache_key" \
  MOPPE_REFRESH_WORLD_CACHE=1 \
  MOPPE_MAPCACHE="$variant/terrain-cache.arrows" \
    "$root/tools/capture-terrain-gazetteer" "$variant"

  mkdir -p "$variant/cache-check"
  MOPPE_METAL_HUD=0 \
  MOPPE_CINEMATIC_CAPTURE_DIR="$variant/cache-check" \
  MOPPE_CINEMATIC_CAPTURE_FRAMES=1 \
  "$root/build/moppe.app/Contents/MacOS/moppe" \
    --windowed \
    --inactive \
    --seed "$seed" \
    --terrain-quality play \
    --uplift-years "$uplift_years" \
    --graphics-quality "$graphics" \
    --world-cache-key "$cache_key" \
    >"$variant/cache-check/stdout.log" \
    2>"$variant/cache-check/stderr.log"
  if ! grep -q "world cache: local=" "$variant/cache-check/stderr.log"; then
    echo "uplift $uplift_years did not load its finished-world cache" >&2
    exit 1
  fi
done

python3 - "$output" <<'PY'
import csv
import pathlib
import sys

root = pathlib.Path(sys.argv[1])
rows = []
fieldnames = None
for path in sorted(root.glob("uplift-*/terrain-summary.csv")):
    with path.open(newline="") as source:
        reader = csv.DictReader(source)
        row = next(reader)
    fieldnames = reader.fieldnames
    capture = {}
    with (path.parent / "capture.txt").open() as source:
        for line in source:
            key, value = line.rstrip().split("=", 1)
            capture[key] = value
    row["process_elapsed_seconds"] = capture["process_elapsed_seconds"]
    rows.append(row)

with (root / "matrix.csv").open("w", newline="") as destination:
    writer = csv.DictWriter(
        destination, fieldnames=[*fieldnames, "process_elapsed_seconds"]
    )
    writer.writeheader()
    writer.writerows(rows)
PY

echo "wrote terrain forcing matrix to $output/matrix.csv"

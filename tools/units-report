TYPED_ROOTS = {"quantity", "quantity_point"}
RAW_FLOATS = {"float", "double"}
RAW_VECTORS = {"Vec3", "Vec2", "Float3", "Float2"}
WRAPPERS = {"optional", "vector", "span", "array"}
ESCAPE_TOKENS = {"numerical_value_in", "numerical_value_ref_in", "force_in"}
HELPER_SOURCES = ("moppe/gfx/math.hh", "moppe/terrain/domain.hh")
QUALIFIERS = {
    "const", "constexpr", "consteval", "constinit", "static", "inline",
    "mutable", "volatile", "thread_local", "extern", "virtual", "explicit",
    "friend", "typename", "register",
}
KEYWORDS = QUALIFIERS | {
    "return", "co_return", "co_yield", "co_await", "throw", "new", "delete",
    "case", "default", "goto", "sizeof", "alignof", "decltype", "typedef",
    "using", "namespace", "struct", "class", "union", "enum", "template",
    "operator", "if", "else", "for", "while", "do", "switch", "break",
    "continue", "public", "private", "protected", "final", "override",
    "noexcept", "requires", "concept", "static_assert", "this", "true",
    "false", "nullptr", "and", "or", "not", "static_cast", "const_cast",
    "reinterpret_cast", "dynamic_cast", "co_await", "export", "import",
    "module", "try", "catch",
}
DECL_FOLLOW = {"=", ";", ",", "{", "[", ")", ":", "("}

STRIP_RE = re.compile(
    r"//[^\n]*"
    r"|/\*.*?\*/"
    r'|R"([^(\s"]*)\(.*?\)\1"'
    r'|"(?:\\.|[^"\\\n])*"'
    r"|(?<![\w'])'(?:\\.|[^'\\\n])+'",
    re.S)
TOKEN_RE = re.compile(r"[A-Za-z_]\w*|::|->|\d[\w.']*|\S")
USING_RE = re.compile(r"\busing\s+([A-Za-z_]\w*)\s*=\s*([^;]*);")
HELPER_DEF_RE = re.compile(
    r"\b(?:float|double|auto|Vec3)\s*&?\s+([A-Za-z_]\w*_value)\s*\(")


def strip(text):
  return STRIP_RE.sub(" ", text)


def tokens_of(text):
  return TOKEN_RE.findall(text)


def is_identifier(token):
  return token[0].isalpha() or token[0] == "_"


def match_close(tokens, start, opening, closing, limit=400):
  """Index of the closer balancing tokens[start] == opening, or None."""
  depth = 0
  end = min(len(tokens), start + limit)
  for k in range(start, end):
    token = tokens[k]
    if token == opening:
      depth += 1
    elif token == closing:
      depth -= 1
      if depth == 0:
        return k
    elif opening == "<" and token in (";", "{", "}"):
      return None
  return None


def parse_type(tokens, i):
  """Parse a declaration's type at i; return (end, type tokens) or None."""
  n = len(tokens)
  j = i
  while j < n and tokens[j] in QUALIFIERS:
    j += 1
  start = j
  if j < n and tokens[j] == "::":
    j += 1
  while True:
    if j >= n or not is_identifier(tokens[j]):
      return None
    if tokens[j] in KEYWORDS:
      return None
    j += 1
    if j < n and tokens[j] == "<":
      close = match_close(tokens, j, "<", ">", limit=120)
      if close is None:
        return None
      j = close + 1
    if j < n and tokens[j] == "::":
      j += 1
      continue
    break
  end_of_type = j
  while j < n and tokens[j] in ("const", "volatile", "&", "*", "&&"):
    j += 1
  return j, tokens[start:end_of_type]


def template_arguments(type_tokens):
  """Top-level template arguments of a type token list."""
  try:
    open_index = type_tokens.index("<")
  except ValueError:
    return []
  arguments, current, depth = [], [], 0
  for token in type_tokens[open_index + 1:]:
    if token in ("<", "(", "["):
      depth += 1
    elif token in (">", ")", "]"):
      if depth == 0:
        break
      depth -= 1
    elif token == "," and depth == 0:
      arguments.append(current)
      current = []
      continue
    current.append(token)
  arguments.append(current)
  return arguments


def head_name(type_tokens):
  """The type's own name: the last qualified component before its '<'."""
  name = None
  depth = 0
  for token in type_tokens:
    if token == "<":
      depth += 1
    elif token == ">":
      depth -= 1
    elif depth == 0 and is_identifier(token) and token not in QUALIFIERS:
      name = token
  return name


class Scanner:
  def __init__(self, typed_aliases, raw_aliases, helpers):
    self.typed_aliases = typed_aliases
    self.raw_aliases = raw_aliases
    self.helpers = helpers

  def kind_of_name(self, name):
    if name in TYPED_ROOTS or name in self.typed_aliases:
      return "typed"
    if name in RAW_FLOATS:
      return "float"
    if name in RAW_VECTORS:
      return "vector"
    return self.raw_aliases.get(name)

  def classify(self, type_tokens):
    """typed, float, vector, auto, or None for a declaration's type."""
    for _ in range(8):
      name = head_name(type_tokens)
      if name in WRAPPERS and "<" in type_tokens:
        arguments = template_arguments(type_tokens)
        if not arguments or not arguments[0]:
          return None
        type_tokens = arguments[0]
        continue
      break
    if name == "auto":
      return "auto"
    if name == "function" and "<" in type_tokens:
      kinds = {self.kind_of_name(t) for t in type_tokens if is_identifier(t)}
      kinds.discard(None)
      if kinds & {"float", "vector"}:
        return "float" if "float" in kinds else "vector"
      if "typed" in kinds:
        return "typed"
      return None
    return self.kind_of_name(name) if name else None

  def auto_initializer_is_typed(self, tokens, k):
    """Whether the `= ...` initializer at tokens[k] carries units."""
    n = len(tokens)
    if k + 1 < n and tokens[k + 1] == "[":
      return False  # a lambda
    depth = 0
    previous = None
    j = k + 1
    typed = False
    while j < n:
      token = tokens[j]
      if token in ("(", "[", "{"):
        depth += 1
      elif token in (")", "]", "}"):
        if depth == 0:
          break
        depth -= 1
      elif depth == 0 and token in (";", ","):
        break
      if token in ESCAPE_TOKENS or token in self.helpers:
        return False
      if token == "::" and previous in ("u", "si", "isq", "mp_units"):
        typed = True
      elif token == "one" and previous in ("[", "*"):
        typed = True
      elif token in TYPED_ROOTS or token in self.typed_aliases:
        typed = True
      previous = token
      j += 1
    return typed

  def extra_declarators(self, tokens, k):
    """Count further declarators after the name at tokens[k-1]."""
    n = len(tokens)
    count = 0
    j = k
    while j < n:
      # Brackets, a function's parameters or a direct-initializer, a
      # braced initializer (or a function body, which ends the run).
      for opening, closing in (("[", "]"), ("(", ")"), ("{", "}")):
        while j < n and tokens[j] == opening:
          close = match_close(tokens, j, opening, closing)
          if close is None:
            return count
          j = close + 1
      if j < n and tokens[j] == "=":
        depth = 0
        while j < n:
          token = tokens[j]
          if token in ("(", "[", "{"):
            depth += 1
          elif token in (")", "]", "}"):
            depth -= 1
            if depth < 0:
              return count
          elif depth == 0 and token in (";", ","):
            break
          j += 1
      if j >= n or tokens[j] != ",":
        return count
      j += 1
      while j < n and tokens[j] in ("*", "&", "&&"):
        j += 1
      if (j + 1 < n and is_identifier(tokens[j])
          and tokens[j] not in KEYWORDS
          and tokens[j + 1] in ("=", ";", ",", "{", "[")):
        count += 1
        j += 1
        continue
      return count
    return count

  def scan(self, text):
    tokens = tokens_of(strip(text))
    counts = {"typed": 0, "float": 0, "vector": 0, "escapes": 0}
    n = len(tokens)
    i = 0
    previous = None
    while i < n:
      token = tokens[i]
      if token in ESCAPE_TOKENS:
        counts["escapes"] += 1
      elif (token in self.helpers and i + 1 < n and tokens[i + 1] == "("
            and previous not in ("float", "double", "auto", "&", "Vec3")):
        counts["escapes"] += 1
      if (is_identifier(token) or token == "::") and previous not in (
          "::", ".", "->", "operator"):
        parsed = parse_type(tokens, i)
        if parsed:
          j, type_tokens = parsed
          if (j + 1 < n and is_identifier(tokens[j])
              and tokens[j] not in KEYWORDS
              and tokens[j + 1] in DECL_FOLLOW):
            kind = self.classify(type_tokens)
            if kind == "auto":
              if (tokens[j + 1] == "="
                  and self.auto_initializer_is_typed(tokens, j + 1)):
                counts["typed"] += 1 + self.extra_declarators(tokens, j + 1)
            elif kind:
              counts[kind] += 1 + self.extra_declarators(tokens, j + 1)
            previous = tokens[j - 1] if j > 0 else None
            i = j
            continue
      previous = token
      i += 1
    return counts


def source_files(root):
  files = []
  for directory in SOURCE_DIRS:
    base = root / directory
    if not base.is_dir():
      continue
    for path in base.rglob("*"):
      if path.suffix in SOURCE_SUFFIXES and path.is_file():
        relative = path.relative_to(root).as_posix()
        if any(part.startswith("build") for part in relative.split("/")):
          continue
        files.append(relative)
  return sorted(files)


def is_generated(relative, text):
  if any(fnmatch.fnmatchcase(relative, p) for p in GENERATED):
    return True
  return text.startswith("// Generated by")


def place_of(relative):
  for name, patterns in BOUNDARIES:
    if any(fnmatch.fnmatchcase(relative, p) for p in patterns):
      return name, True
  for name, patterns in AREAS:
    if any(fnmatch.fnmatchcase(relative, p) for p in patterns):
      return name, False
  return None, False


def discover_aliases(texts):
  # A name counts only when every one of its definitions agrees: a
  # value_type or influence_type that is float in one template and a
  # quantity in another classifies nothing.
  definitions = {}
  for text in texts:
    for match in USING_RE.finditer(text):
      definitions.setdefault(match.group(1), []).append(
          set(tokens_of(match.group(2))))
  typed = set()
  changed = True
  while changed:
    changed = False
    for name, sides in sorted(definitions.items()):
      if name not in typed and all(
          rhs & TYPED_ROOTS or rhs & typed for rhs in sides):
        typed.add(name)
        changed = True
  raw = {}
  for name, sides in sorted(definitions.items()):
    if name in typed or name in RAW_FLOATS | RAW_VECTORS:
      continue
    if all(rhs <= RAW_FLOATS | QUALIFIERS for rhs in sides):
      raw[name] = "float"
    elif all(rhs <= RAW_VECTORS | QUALIFIERS for rhs in sides):
      raw[name] = "vector"
  return typed, raw


def discover_helpers(root):
  helpers = set()
  for relative in HELPER_SOURCES:
    path = root / relative
    if path.is_file():
      helpers.update(HELPER_DEF_RE.findall(strip(path.read_text())))
  return helpers


def share(row):
  denominator = row["typed"] + row["float"] + row["vector"]
  if denominator == 0:
    return None
  return 100.0 * row["typed"] / denominator


def empty_row(name):
  return {"name": name, "files": 0, "lines": 0, "typed": 0, "float": 0,
          "vector": 0, "escapes": 0}


def add(row, other):
  for key in ("files", "lines", "typed", "float", "vector", "escapes"):
    row[key] += other[key]


def measure(root):
  root = pathlib.Path(root)
  texts = {}
  for relative in source_files(root):
    text = (root / relative).read_text(errors="replace")
    if not is_generated(relative, text):
      texts[relative] = text
  typed_aliases, raw_aliases = discover_aliases(
      strip(t) for t in texts.values())
  scanner = Scanner(typed_aliases, raw_aliases, discover_helpers(root))
  files = []
  for relative, text in texts.items():
    place, boundary = place_of(relative)
    counts = scanner.scan(text)
    row = {"name": relative, "place": place, "boundary": boundary,
           "files": 1, "lines": text.count("\n"), **counts}
    row["share"] = share(row)
    files.append(row)
  areas = {name: empty_row(name) for name, _ in AREAS}
  boundaries = {name: empty_row(name) for name, _ in BOUNDARIES}
  for row in files:
    if row["place"] is None:
      continue
    add((boundaries if row["boundary"] else areas)[row["place"]], row)
  for row in (*areas.values(), *boundaries.values()):
    row["share"] = share(row)
  areas = [row for row in areas.values() if row["files"]]
  boundaries = [row for row in boundaries.values() if row["files"]]
  totals = []
  for name, rows in (("Total (areas)", areas),
                     ("Total (with boundaries)", areas + boundaries)):
    total = empty_row(name)
    for row in rows:
      add(total, row)
    total["share"] = share(total)
    totals.append(total)
  return {"areas": sorted(areas, key=sort_key),
          "boundaries": sorted(boundaries, key=sort_key),
          "totals": totals, "files": files,
          "typed_aliases": sorted(typed_aliases),
          "raw_aliases": dict(sorted(raw_aliases.items())),
          "helpers": sorted(scanner.helpers)}


def sort_key(row):
  value = row["share"]
  return (value is None, value if value is not None else 0.0,
          -(row["float"] + row["vector"]), row["name"])


def format_share(value):
  return "—" if value is None else f"{value:.1f}"


COLUMNS = ("Files", "Lines", "Typed", "Raw float", "Raw vector", "Escapes",
           "Typed share %")


def table(title, rows):
  width = max([len(title)] + [len(row["name"]) for row in rows])
  header = f"| {title:<{width}} | " + " | ".join(COLUMNS) + " |"
  rule = "|" + "-" * (width + 2) + "|" + "|".join(
      "-" * (len(c) + 1) + ":" for c in COLUMNS) + "|"
  lines = [header, rule]
  for row in rows:
    values = (row["files"], row["lines"], row["typed"], row["float"],
              row["vector"], row["escapes"])
    cells = [f"{v:>{len(c)}}" for v, c in zip(values, COLUMNS)]
    cells.append(f"{format_share(row['share']):>{len(COLUMNS[-1])}}")
    lines.append(f"| {row['name']:<{width}} | " + " | ".join(cells) + " |")
  return "\n".join(lines)


def find_place(report, query):
  names = [row["name"] for row in report["areas"] + report["boundaries"]]
  lowered = query.lower()
  exact = [name for name in names if name.lower() == lowered]
  if exact:
    return exact[0]
  partial = [name for name in names if lowered in name.lower()]
  if len(partial) == 1:
    return partial[0]
  raise SystemExit(
      f"no single area matches {query!r}; areas: " + ", ".join(names))


def baseline_path(root):
  return pathlib.Path(root) / BASELINE


def write_baseline(root, report):
  baseline = {
      "comment": "Typed-quantity ratchet for tools/units-report --check. "
                 "Regenerate with tools/units-report --update.",
      "areas": {
          row["name"]: {
              "share": round(row["share"], 1) if row["share"] is not None
              else None,
              "files": row["files"], "typed": row["typed"],
              "raw_float": row["float"], "raw_vector": row["vector"],
              "escapes": row["escapes"],
          }
          for row in sorted(report["areas"], key=lambda r: r["name"])
      },
  }
  path = baseline_path(root)
  path.write_text(json.dumps(baseline, indent=2, ensure_ascii=False) + "\n")
  return path


def check(root, report):
  path = baseline_path(root)
  if not path.is_file():
    print(f"no baseline at {BASELINE}; run tools/units-report --update",
          file=sys.stderr)
    return 1
  baseline = json.loads(path.read_text())["areas"]
  failures, notes = [], []
  current = {row["name"]: row for row in report["areas"]}
  for name, row in sorted(current.items()):
    if name not in baseline:
      notes.append(f"{name}: not in the baseline (now "
                   f"{format_share(row['share'])}%)")
      continue
    held = baseline[name]
    counted = held["typed"] + held["raw_float"] + held["raw_vector"]
    before = 100.0 * held["typed"] / counted if counted else None
    now = row["share"]
    if before is None or now is None:
      continue
    if now < before - 1e-9:
      failures.append(f"{name}: typed share fell from {before:.2f}% to "
                      f"{now:.2f}% ({now - before:+.2f} points)")
  for name in sorted(set(baseline) - set(current)):
    notes.append(f"{name}: in the baseline but no longer measured")
  for note in notes:
    print(f"note: {note}")
  if failures:
    for failure in failures:
      print(f"FAIL {failure}")
    print("Type the new declarations (moppe/quantities.hh, moppe/gfx/"
          "math.hh), or if the drop is deliberate, run tools/units-report "
          "--update and commit tools/units-baseline.json.")
    return 1
  print(f"Typed-quantity ratchet holds: {len(current)} areas at or above "
        f"{BASELINE}.")
  return 0


def main():
  parser = argparse.ArgumentParser(
      description=__doc__.split("\n")[0],
      formatter_class=argparse.RawDescriptionHelpFormatter,
      epilog="""\
The ratchet: --check fails when any area's typed share falls at all
below the one its counts in tools/units-baseline.json give. A thread that
raises an area's share runs --update and commits the baseline with its
change. A baseline conflict between threads is resolved by merging the
code and rerunning --update after the merge.

Counting rules, the area table, and the boundary table are at the top
of this script.""")
  parser.add_argument("--root", type=pathlib.Path, default=DEFAULT_ROOT,
                      help="repository to measure (default: this one)")
  mode = parser.add_mutually_exclusive_group()
  mode.add_argument("--files", metavar="AREA",
                    help="list one area's (or boundary's) files, worst first")
  mode.add_argument("--json", action="store_true",
                    help="print the whole report as JSON")
  mode.add_argument("--check", action="store_true",
                    help=f"fail if an area fell below {BASELINE}")
  mode.add_argument("--update", action="store_true",
                    help=f"rewrite {BASELINE} from the current tree")
  mode.add_argument("--unmapped", action="store_true",
                    help="list counted files that land in no area")
  mode.add_argument("--aliases", action="store_true",
                    help="list the discovered typed and raw aliases and "
                         "boundary helpers")
  args = parser.parse_args()
  report = measure(args.root)
  unmapped = [row["name"] for row in report["files"] if row["place"] is None]

  if args.check:
    return check(args.root, report)
  if args.update:
    path = write_baseline(args.root, report)
    print(f"wrote {path}")
    return 0
  if args.json:
    print(json.dumps(report, indent=2, ensure_ascii=False))
    return 0
  if args.unmapped:
    for name in unmapped:
      print(name)
    return 0
  if args.aliases:
    print("typed aliases: " + " ".join(report["typed_aliases"]))
    print("raw aliases: " + " ".join(
        f"{k}={v}" for k, v in report["raw_aliases"].items()))
    print("boundary helpers: " + " ".join(report["helpers"]))
    return 0
  if args.files:
    place = find_place(report, args.files)
    rows = sorted((row for row in report["files"] if row["place"] == place),
                  key=sort_key)
    print(table(place, rows))
    return 0
  print(table("Area", report["areas"]))
  print()
  print(table("Boundaries (not ratcheted)", report["boundaries"]))
  print()
  print(table("Total", report["totals"]))
  if unmapped:
    print(f"\n{len(unmapped)} files land in no area: see --unmapped",
          file=sys.stderr)
  return 0


if __name__ == "__main__":
  sys.exit(main())

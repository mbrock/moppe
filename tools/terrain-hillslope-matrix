#!/usr/bin/env bash
set -euo pipefail

if [[ $# -ne 1 ]]; then
  echo "usage: tools/terrain-hillslope-matrix OUTPUT_DIR" >&2
  exit 2
fi

root=$(cd "$(dirname "$0")/.." && pwd)
output=$1
seed=${MOPPE_SEED:-123}
graphics=${MOPPE_GAZETTEER_GRAPHICS:-high}
window=${MOPPE_GAZETTEER_WINDOW:-1600x900}
settle=${MOPPE_GAZETTEER_SETTLE:-18}
channel_area=${MOPPE_CHANNEL_INITIATION_AREA:-25}
critical_gradient=${MOPPE_HILLSLOPE_CRITICAL_GRADIENT:-0.8}
multipliers=${MOPPE_HILLSLOPE_MULTIPLIERS:-"1 2 4"}

if [[ ! $channel_area =~ ^[1-9][0-9]*$ ]]; then
  echo "MOPPE_CHANNEL_INITIATION_AREA must be a positive integer" >&2
  exit 2
fi
if [[ ! $critical_gradient =~ ^(0|[0-9]+)(\.[0-9]+)?$ ]]; then
  echo "MOPPE_HILLSLOPE_CRITICAL_GRADIENT must be a decimal" >&2
  exit 2
fi

mkdir -p "$output"

for multiplier in $multipliers; do
  if [[ ! $multiplier =~ ^[1-9][0-9]*(\.[0-9]+)?$ ]]; then
    echo "MOPPE_HILLSLOPE_MULTIPLIERS must contain factors at least one" >&2
    exit 2
  fi
  suffix=${multiplier/./p}
  variant="$output/waste-$suffix"
  cache_key="waste-$suffix-slope-${critical_gradient/./p}"
  if [[ -f $variant/terrain-summary.csv &&
        -f $variant/terrain-spectrum.csv &&
        -f $variant/capture.txt &&
        -f $variant/cache-check/stderr.log ]] &&
     grep -q "world cache: local=" "$variant/cache-check/stderr.log"; then
    echo "reusing completed hillslope multiplier $multiplier"
    continue
  fi
  if [[ -f $variant/failure.txt ]]; then
    echo "reusing failed hillslope multiplier $multiplier"
    continue
  fi
  mkdir -p "$variant"
  set +e
  MOPPE_SEED="$seed" \
  MOPPE_TERRAIN_PROFILE=play \
  MOPPE_GAZETTEER_GRAPHICS="$graphics" \
  MOPPE_GAZETTEER_WINDOW="$window" \
  MOPPE_GAZETTEER_SETTLE="$settle" \
  MOPPE_UPLIFT_YEARS=500000 \
  MOPPE_CHANNEL_INITIATION_AREA="$channel_area" \
  MOPPE_HILLSLOPE_CRITICAL_GRADIENT="$critical_gradient" \
  MOPPE_HILLSLOPE_MAX_MULTIPLIER="$multiplier" \
  MOPPE_WORLD_CACHE_KEY="$cache_key" \
  MOPPE_REFRESH_WORLD_CACHE=1 \
  MOPPE_MAPCACHE="$variant/terrain-cache.arrows" \
    "$root/tools/capture-terrain-gazetteer" "$variant"
  capture_status=$?
  set -e
  if [[ $capture_status -ne 0 ]]; then
    printf 'capture_exit_status=%s\n' "$capture_status" \
      >"$variant/failure.txt"
    echo "hillslope multiplier $multiplier failed with status $capture_status" \
      >&2
    continue
  fi

  "$root/tools/terrain-spectrum" "$variant"

  mkdir -p "$variant/cache-check"
  MOPPE_METAL_HUD=0 \
  MOPPE_CINEMATIC_CAPTURE_DIR="$variant/cache-check" \
  MOPPE_CINEMATIC_CAPTURE_FRAMES=1 \
  "$root/build/moppe.app/Contents/MacOS/moppe" \
    --windowed \
    --inactive \
    --seed "$seed" \
    --terrain-quality play \
    --uplift-years 500000 \
    --channel-initiation-area "$channel_area" \
    --hillslope-critical-gradient "$critical_gradient" \
    --hillslope-max-multiplier "$multiplier" \
    --graphics-quality "$graphics" \
    --world-cache-key "$cache_key" \
    >"$variant/cache-check/stdout.log" \
    2>"$variant/cache-check/stderr.log"
  if ! grep -q "world cache: local=" "$variant/cache-check/stderr.log"; then
    echo "hillslope multiplier $multiplier did not load its world cache" >&2
    exit 1
  fi
done

python3 - "$output" <<'PY'
import csv
import pathlib
import sys

root = pathlib.Path(sys.argv[1])
rows = []
fieldnames = None
for path in sorted(
    root.glob("waste-*/terrain-summary.csv"),
    key=lambda item: float(
        item.parent.name.removeprefix("waste-").replace("p", ".")
    ),
):
    with path.open(newline="") as source:
        summary_reader = csv.DictReader(source)
        row = next(summary_reader)
    with (path.parent / "terrain-spectrum.csv").open(newline="") as source:
        spectrum_reader = csv.DictReader(source)
        row.update(next(spectrum_reader))
    capture = {}
    with (path.parent / "capture.txt").open() as source:
        for line in source:
            key, value = line.rstrip().split("=", 1)
            capture[key] = value
    row["process_elapsed_seconds"] = capture["process_elapsed_seconds"]
    fieldnames = [
        *summary_reader.fieldnames,
        *spectrum_reader.fieldnames,
        "process_elapsed_seconds",
    ]
    rows.append(row)

with (root / "matrix.csv").open("w", newline="") as destination:
    writer = csv.DictWriter(destination, fieldnames=fieldnames)
    writer.writeheader()
    writer.writerows(rows)

with (root / "failures.csv").open("w", newline="") as destination:
    writer = csv.writer(destination)
    writer.writerow(["maximum_hillslope_multiplier", "failure"])
    for path in sorted(root.glob("waste-*/failure.txt")):
        multiplier = path.parent.name.removeprefix("waste-").replace("p", ".")
        writer.writerow([multiplier, path.read_text().strip()])
PY

echo "wrote terrain hillslope matrix to $output/matrix.csv"

def ffmpeg (*arguments):
  subprocess.run (["ffmpeg", "-hide_banner", "-loglevel", "error", "-y",
                   *arguments], check=True)


def game_path ():
  build = os.environ.get ("MOPPE_BUILD_DIR", os.path.join (ROOT, "build"))
  if sys.platform == "darwin":
    return os.path.join (build, "moppe.app", "Contents", "MacOS", "moppe")
  return os.path.join (build, "moppe")


def record (work, name):
  scene, seconds, options, switches = CLIPS[name]
  output = os.path.join (work, f"{name}.mp4")
  environment = dict (os.environ, MOPPE_HUD="none", **switches)
  if name in REELS:
    reel = os.path.join (work, f"{name}.txt")
    with open (reel, "w") as file:
      file.write (WORLD + "".join (REELS[name][1]) + "arrival hold 1\n")
    environment["MOPPE_OPENING"] = reel
  # A window cannot be larger than the screen; on a 2x display a window of
  # half the size in points gives the whole picture.
  size = f"{WIDTH}x{HEIGHT}"
  if sys.platform == "darwin":
    size = f"{WIDTH // 2}x{HEIGHT // 2}"
    environment["MOPPE_VIDEO_HEIGHT"] = str (HEIGHT)
  with open (os.path.join (work, f"{name}.log"), "w") as log:
    subprocess.run ([os.path.join (ROOT, "tools", "record"), output,
                     scene, "--seconds", str (seconds), "--fps", str (FPS),
                     "--size", size, *options],
                    env=environment, stdout=log, stderr=subprocess.STDOUT,
                    check=True)
  print (f"vista: recorded {name}", file=sys.stderr)


# -- the HUD -----------------------------------------------------------------

def dms (degrees, positive, negative):
  sign = positive if degrees >= 0 else negative
  degrees = abs (degrees)
  d = int (degrees)
  m = int ((degrees - d) * 60)
  s = int (round (((degrees - d) * 60 - m) * 60))
  return f"{d}°{m:02d}′{s:02d}″{sign}"


def place (x, z):
  """Latitude and longitude of world metres: 60°N at the middle, north
  along -Z."""
  latitude = 60.0 + (2500.0 - z) / 111320.0
  longitude = 14.0 + x / 55660.0
  return f"{dms (latitude, 'N', 'S')}  {dms (longitude, 'E', 'W')}"


def hour_text (hour):
  minutes = int (round (hour * 60)) % (24 * 60)
  return f"{minutes // 60:02d}:{minutes % 60:02d}"


SHADE = """<defs><filter id="shade" x="-20%" y="-50%" width="140%" height="200%">
<feGaussianBlur in="SourceAlpha" stdDeviation="7" result="wide"/>
<feComponentTransfer in="wide" result="soft">
<feFuncA type="linear" slope="0.7"/></feComponentTransfer>
<feMerge><feMergeNode in="soft"/><feMergeNode in="SourceGraphic"/></feMerge>
</filter></defs>"""


def svg (body):
  return (f'<svg xmlns="http://www.w3.org/2000/svg" width="{WIDTH}" '
          f'height="{HEIGHT}" font-family="Geomini">{SHADE}'
          f'<g filter="url(#shade)" fill="#fbf6ec" stroke="#fbf6ec">'
          f'{body}</g></svg>')


def text (x, y, words, size, spacing=0, opacity=1.0, anchor="start",
          weight="normal"):
  return (f'<text x="{x}" y="{y}" font-size="{size}" stroke="none" '
          f'letter-spacing="{spacing}" opacity="{opacity}" '
          f'text-anchor="{anchor}" font-weight="{weight}">'
          f'{html.escape (words)}</text>')


def tag_svg (index, chapter, info):
  """A view's tag, low on the left: a rule, the chapter, the name, what it
  is, and where."""
  x, top = 92, 1330
  lines = [
    f'<line x1="{x}" y1="{top}" x2="{x}" y2="{top + 188}" '
    f'stroke-width="2" opacity="0.85"/>',
    f'<rect x="{x - 5}" y="{top - 5}" width="10" height="10" '
    f'stroke="none" transform="rotate(45 {x} {top})"/>',
    text (x + 28, top + 12, f"{index:02d}  ·  {chapter.upper ()}", 23, 7,
          0.75),
    text (x + 26, top + 84, info["name"].upper (), 66, 9),
    text (x + 28, top + 128, info["note"], 30, 1, 0.9),
  ]
  if info["where"]:
    px, pz, ground = info["where"]
    lines.append (text (x + 28, top + 176,
                        f"{place (px, pz)}   ▲ {max (ground - SEA, 0):.0f} m"
                        f"   {hour_text (info['hour'])}",
                        22, 2, 0.7))
  return svg ("".join (lines))


def chapter_svg (index, name):
  """A chapter's card, high in the middle: its number over a rule, and its
  name spaced out beneath."""
  cx, top = WIDTH // 2, 300
  return svg ("".join ([
    text (cx, top, f"{index:02d}", 30, 10, 0.8, "middle"),
    f'<line x1="{cx - 70}" y1="{top + 26}" x2="{cx + 70}" y2="{top + 26}" '
    f'stroke-width="1.5" opacity="0.8"/>',
    text (cx, top + 98, name.upper (), 58, 18, 1.0, "middle"),
  ]))


def title_svg (end):
  cx = WIDTH // 2
  lines = [text (cx, 820, TITLE, 210, 4, 1.0, "middle"),
           f'<line x1="{cx - 90}" y1="{872}" x2="{cx + 90}" y2="{872}" '
           f'stroke-width="1.5" opacity="0.8"/>']
  if end:
    lines.append (text (cx, 936, URL, 44, 6, 0.9, "middle"))
  else:
    lines.append (text (cx, 936, TAGLINE.upper (), 30, 12, 0.85, "middle"))
  return svg ("".join (lines))


def render_svg (work, name, source):
  folder = os.path.join (work, "hud")
  os.makedirs (folder, exist_ok=True)
  vector, image = (os.path.join (folder, f"{name}.svg"),
                   os.path.join (folder, f"{name}.png"))
  with open (vector, "w") as file:
    file.write (source)
  config = os.path.join (folder, "fonts.conf")
  if not os.path.exists (config):
    with open (config, "w") as file:
      file.write ('<?xml version="1.0"?><fontconfig>'
                  '<include ignore_missing="yes">/opt/homebrew/etc/fonts/'
                  'fonts.conf</include><include ignore_missing="yes">'
                  '/etc/fonts/fonts.conf</include>'
                  f'<dir>{FONTS}</dir></fontconfig>')
  subprocess.run (["rsvg-convert", "-o", image, vector], check=True,
                  env=dict (os.environ, FONTCONFIG_FILE=config,
                                 PANGOCAIRO_BACKEND="fc"))
  return image


# -- the cut -----------------------------------------------------------------

def cut (work, index, clip):
  name, start, seconds = clip[:3]
  speed = clip[3] if len (clip) > 3 else 1
  output = os.path.join (work, "cut", f"{index:02d}-{name}.mp4")
  filters = []
  if speed != 1:
    filters.append (f"setpts=PTS/{speed}")
  filters.append (f"scale={WIDTH}:{HEIGHT}:flags=lanczos,fps={FPS},setsar=1")
  ffmpeg ("-ss", str (start), "-t", str (seconds * speed), "-i",
          os.path.join (work, f"{name}.mp4"), "-vf", ",".join (filters),
          "-an", "-c:v", "libx264", "-crf", "10", "-preset", "veryfast",
          "-pix_fmt", "yuv420p", output)
  return output, seconds


# Cross-dissolves between cuts, in seconds.
DISSOLVE = 0.6


def assemble (work, output, draft):
  os.makedirs (os.path.join (work, "cut"), exist_ok=True)
  cuts, overlays, now = [], [], 0.0
  chapter_number, chapter_name = 0, ""
  for kind, name, section in FILM:
    if kind == "chapter":
      chapter_number += 1
      chapter_name = name
      image = render_svg (work, f"chapter-{chapter_number}",
                          chapter_svg (chapter_number, name))
      overlays.append ((image, now + 0.3, now + 3.0, 0.6, 0))
    for clip, info in section:
      path, length = cut (work, len (cuts), clip)
      begin = now
      cuts.append ((path, length))
      now += length - DISSOLVE
      if info:
        image = render_svg (work, f"tag-{len (cuts)}",
                            tag_svg (chapter_number, chapter_name, info))
        overlays.append ((image, begin + 0.7, begin + length - 0.6, 0.5,
                          -26))
    if kind == "title":
      overlays.append ((render_svg (work, "title", title_svg (False)),
                        1.2, now - 0.3, 1.0, 0))
    elif kind == "end":
      overlays.append ((render_svg (work, "end", title_svg (True)),
                        now - length + DISSOLVE + 1.2, now + DISSOLVE, 1.0,
                        0))
  total = now + DISSOLVE

  inputs, graph = [], []
  for path, _ in cuts:
    inputs += ["-i", path]
  # Each cut dissolves into the next.
  offset, last = 0.0, "[0:v]"
  for n in range (1, len (cuts)):
    offset += cuts[n - 1][1] - DISSOLVE
    graph.append (f"{last}[{n}:v]xfade=transition=fade:"
                  f"duration={DISSOLVE}:offset={offset:.3f}[x{n}]")
    last = f"[x{n}]"
  # The film rises from black and falls to it.
  graph.append (f"{last}fade=in:st=0:d=1.2,"
                f"fade=out:st={total - 1.2:.2f}:d=1.2[v0]")
  first = len (cuts)
  for n, (image, appears, goes, fade, slide) in enumerate (overlays, 1):
    # Each overlay is decoded only while it shows.
    goes = min (goes, total)
    length = goes - appears
    inputs += ["-loop", "1", "-framerate", str (FPS), "-t",
               f"{length:.2f}", "-i", image]
    graph.append (f"[{first + n - 1}:v]format=rgba,"
                  f"fade=in:st=0:d={fade}:alpha=1,"
                  f"fade=out:st={length - fade:.2f}:d={fade}:alpha=1,"
                  f"setpts=PTS+{appears:.3f}/TB[o{n}]")
    # A tag drifts in from the left as it fades up.
    x = "0" if not slide else \
      f"'{slide}*max(0,1-(t-{appears:.2f})/0.9)'"
    graph.append (f"[v{n - 1}][o{n}]overlay=x={x}:y=0:eof_action=pass:"
                  f"enable="
                  f"'between(t,{appears:.2f},{goes:.2f})'[v{n}]")
  # A silent track: some players and uploaders want one.
  inputs += ["-f", "lavfi", "-t", f"{total:.2f}", "-i",
             "anullsrc=channel_layout=stereo:sample_rate=48000"]
  script = os.path.join (work, "cut", "graph.txt")
  with open (script, "w") as file:
    file.write (";\n".join (graph))
  ffmpeg (*inputs, "-filter_complex_script", script, "-map",
          f"[v{len (overlays)}]", "-map", f"{first + len (overlays)}:a",
          "-c:v", "libx264", "-crf", "18", "-preset",
          "veryfast" if draft else "slow", "-pix_fmt", "yuv420p", "-r",
          str (FPS), "-c:a", "aac", "-b:a", "96k", "-movflags",
          "+faststart", "-t", f"{total:.2f}", output)
  print (f"{output}: {total:.1f} s")


def main ():
  parser = argparse.ArgumentParser (
    description=__doc__, formatter_class=argparse.RawTextHelpFormatter)
  parser.add_argument ("output")
  parser.add_argument ("--work", default=os.path.join (ROOT, "build",
                                                       "vista"))
  parser.add_argument ("--fresh", action="store_true")
  parser.add_argument ("--draft", action="store_true")
  parser.add_argument ("--only", nargs="+", default=[])
  options = parser.parse_args ()

  if not shutil.which ("ffmpeg") and shutil.which ("nix") and \
     not os.environ.get ("MOPPE_RECORD_SHELL"):
    os.environ["MOPPE_RECORD_SHELL"] = "1"
    os.execvp ("nix", ["nix", "develop", ROOT, "-c", *sys.argv])
  if not shutil.which ("rsvg-convert"):
    sys.exit ("vista: the HUD needs rsvg-convert (librsvg)")
  if not os.access (game_path (), os.X_OK):
    sys.exit ("vista: moppe is not built; run cmake --build build first")

  work = os.path.abspath (options.work)
  os.makedirs (work, exist_ok=True)
  missing = [name for name in CLIPS if name in options.only or
             options.fresh or
             not os.path.exists (os.path.join (work, f"{name}.mp4"))]
  with concurrent.futures.ThreadPoolExecutor (max_workers=2) as pool:
    list (pool.map (lambda name: record (work, name), missing))
  assemble (work, os.path.abspath (options.output), options.draft)


if __name__ == "__main__":
  main ()

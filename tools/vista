def reel_time (reel, name, into=0.0):
  """Seconds into a reel's recording where shot NAME is INTO seconds old."""
  now = 0.0
  for line in REELS[reel][1]:
    hold = float (line.split (" hold ")[1].split ()[0])
    if line.split ()[1] == name:
      return now + into
    now += hold
  raise KeyError (name)


def view (name, seconds, into=0.6):
  """A cut of SECONDS from the held view NAME, INTO seconds into it."""
  for reel, (_, shots) in REELS.items ():
    if any (line.split ()[1] == name for line in shots):
      return (reel, reel_time (reel, name, into), seconds)
  raise KeyError (name)


# Where a view lies, for its tag: (x, z, metres of ground) or None.
def tag (name, note, where=None, hour=None):
  return dict (name=name, note=note, where=where, hour=hour)


